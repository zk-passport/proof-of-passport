{
  "name": "@selfxyz/mobile-app",
  "version": "2.9.30",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "analyze:bundle:android": "pnpm build:deps && node ./scripts/bundle-analyze-ci.cjs android",
    "analyze:bundle:ios": "pnpm build:deps && node ./scripts/bundle-analyze-ci.cjs ios",
    "analyze:tree-shaking": "node ./scripts/analyze-tree-shaking.cjs imports",
    "analyze:tree-shaking:web": "pnpm web:build && node ./scripts/analyze-tree-shaking.cjs web",
    "android": "pnpm build:deps && pnpm setup:android-deps && react-native run-android --active-arch-only",
    "android:ci": "./scripts/mobile-ci-build-android.sh",
    "build:deps": "pnpm -r --filter @selfxyz/mobile-app... run build",
    "bump-version:major": "npm version major && pnpm sync-versions",
    "bump-version:minor": "npm version minor && pnpm sync-versions",
    "bump-version:patch": "npm version patch && pnpm sync-versions",
    "clean": "pnpm clean:watchman && pnpm clean:build && pnpm clean:ios && pnpm clean:xcode && pnpm clean:pod-cache && pnpm clean:android-deps && pnpm clean:node",
    "clean:android-deps": "node scripts/cleanup-private-modules.cjs",
    "clean:build": "rm -rf ios/build android/app/build android/build",
    "clean:ios": "rm -rf ios/Pods ios/Podfile.lock",
    "clean:node": "rm -rf ../node_modules node_modules",
    "clean:pod-cache": "cd ios && pod cache clean --all && cd ..",
    "clean:ruby": "rm -rf vendor/bundle",
    "clean:watchman": "watchman watch-del-all",
    "clean:xcode": "rm -rf ~/Library/Developer/Xcode/DerivedData",
    "clean:xcode-env-local": "rm -f ios/.xcode.env.local",
    "find:type-imports": "node scripts/find-type-import-issues.mjs",
    "fmt": "pnpm prettier --check --cache .",
    "fmt:fix": "pnpm prettier --write --cache .",
    "format": "pnpm nice && pnpm fmt:fix",
    "ia": "pnpm install-app",
    "imports:fix": "node ./scripts/alias-imports.cjs",
    "install-app": "pnpm install-app:setup && pnpm clean:xcode-env-local",
    "install-app:mobile-deploy": "pnpm install && pnpm build:deps && pnpm clean:xcode-env-local",
    "install-app:setup": "pnpm install && pnpm build:deps && pnpm setup:android-deps && cd ios && ./scripts/install-ios-deps-if-needed.sh && cd ..",
    "ios": "node scripts/preflight-workspace-config.cjs && pnpm build:deps && ios/scripts/install-ios-deps-if-needed.sh && node scripts/run-ios-simulator.cjs",
    "ios:fastlane-debug": "pnpm reinstall && bundle exec fastlane --verbose ios internal_test",
    "jest:clear": "pnpm exec jest --clearCache",
    "jest:run": "pnpm exec jest",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint --fix . --cache --cache-location .eslintcache",
    "mobile-deploy": "node scripts/mobile-deploy-confirm.cjs both",
    "mobile-deploy:android": "node scripts/mobile-deploy-confirm.cjs android",
    "mobile-deploy:ios": "node scripts/mobile-deploy-confirm.cjs ios",
    "mobile-local-deploy": "FORCE_UPLOAD_LOCAL_DEV=true node scripts/mobile-deploy-confirm.cjs both",
    "mobile-local-deploy:android": "FORCE_UPLOAD_LOCAL_DEV=true node scripts/mobile-deploy-confirm.cjs android",
    "mobile-local-deploy:ios": "FORCE_UPLOAD_LOCAL_DEV=true node scripts/mobile-deploy-confirm.cjs ios",
    "nice": "sh -c 'if [ -z \"$SKIP_BUILD_DEPS\" ]; then pnpm build:deps; fi; pnpm imports:fix && pnpm lint:fix'",
    "reinstall": "pnpm -w run reinstall-app",
    "release": "./scripts/release.sh",
    "release:major": "./scripts/release.sh major",
    "release:minor": "./scripts/release.sh minor",
    "release:patch": "./scripts/release.sh patch",
    "setup": "pnpm clean:build && pnpm install && pnpm build:deps && pnpm setup:android-deps && cd ios && scripts/install-ios-deps-if-needed.sh && cd .. && pnpm clean:xcode-env-local",
    "setup:android-deps": "node scripts/setup-private-modules.cjs && node scripts/publish-kmp-local.cjs",
    "start": "node scripts/preflight-workspace-config.cjs && watchman watch-del-all && pnpm watch:sdk & react-native start",
    "start:clean": "node scripts/preflight-workspace-config.cjs && watchman watch-del-all && cd android && ./gradlew clean && cd .. && pnpm watch:sdk & react-native start --reset-cache",
    "sync-versions": "bundle exec fastlane ios sync_version && bundle exec fastlane android sync_version",
    "tag:release": "node scripts/tag.cjs release",
    "tag:remove": "node scripts/tag.cjs remove",
    "test": "pnpm jest:run --passWithNoTests && node --test scripts/tests/*.cjs",
    "test:build": "pnpm build:deps && pnpm types && node ./scripts/bundle-analyze-ci.cjs ios && pnpm test",
    "test:ci": "pnpm jest:run --passWithNoTests && node --test scripts/tests/*.cjs",
    "test:coverage": "pnpm jest:run --coverage --passWithNoTests",
    "test:coverage:ci": "pnpm jest:run --coverage --passWithNoTests --ci --coverageReporters=lcov --coverageReporters=text --coverageReporters=json",
    "test:e2e:android": "./scripts/test-e2e-local.sh android --ci-match",
    "test:e2e:ios": "./scripts/test-e2e-local.sh ios --ci-match",
    "test:fastlane": "bundle exec ruby -Itest fastlane/test/helpers_test.rb",
    "test:tree-shaking": "node ./scripts/test-tree-shaking.cjs",
    "test:web-build": "pnpm jest:run tests/web-build-render.test.ts --testTimeout=180000",
    "types": "tsc --noEmit",
    "watch:sdk": "pnpm --filter @selfxyz/mobile-sdk-alpha watch",
    "web": "vite",
    "web:build": "pnpm build:deps && vite build",
    "web:preview": "vite preview"
  },
  "overrides": {
    "punycode": "npm:punycode.js@2.3.1",
    "react-native-blur-effect": "1.1.3",
    "react-native-webview": "13.16.0"
  },
