{
  "name": "@selfxyz/rn-sdk",
  "version": "0.0.1-alpha.1",
  "description": "Self Protocol React Native SDK \u2014 thin WebView wrapper for identity verification",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "android",
    "ios",
    "selfxyz-rn-sdk.podspec",
    "react-native.config.cjs"
  ],
  "scripts": {
    "build": "pnpm --filter @selfxyz/webview-app build && pnpm copy-assets && tsup",
    "copy-assets": "rm -rf ./assets/self-wallet && mkdir -p ./assets/self-wallet && cp -r ../webview-app/dist/. ./assets/self-wallet/ && node scripts/strip-embedded-sri.cjs",
    "prepublishOnly": "pnpm build",
    "test": "pnpm copy-assets && tsup && vitest run",
    "typecheck": "tsc --noEmit",
    "types": "tsup"
  },
  "dependencies": {
    "@selfxyz/webview-bridge": "workspace:^"
  },
  "devDependencies": {
    "@selfxyz/webview-app": "workspace:^",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "react-native": "0.83.9",
    "react-native-biometrics": "^3.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-keychain": "^9.2.3",
    "react-native-nfc-manager": "^3.17.2",
    "react-native-webview": "13.16.0",
    "tsup": "^8.0.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@selfxyz/rn-mrz-scanner": "workspace:^",
    "@selfxyz/rn-nfc-passport": "workspace:^",
    "react": "^19.0.0",
    "react-native": ">=0.83.0",
    "react-native-biometrics": "^3.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-keychain": ">=8.2.0 <11",
    "react-native-nfc-manager": "^3.14.0",
    "react-native-webview": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@selfxyz/rn-mrz-scanner": {
      "optional": true
    },
    "@selfxyz/rn-nfc-passport": {
      "optional": true
    },
    "react-native-biometrics": {
      "optional": true
    },
    "react-native-fs": {
      "optional": true
    },
    "react-native-keychain": {
      "optional": true
    },
    "react-native-nfc-manager": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  }
}
