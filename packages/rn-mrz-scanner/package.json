{
  "name": "@selfxyz/rn-mrz-scanner",
  "version": "0.0.1-alpha.1",
  "description": "Optional MRZ camera scanner native module for @selfxyz/rn-sdk (registers SelfMRZScannerModule)",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "android",
    "ios",
    "scripts/postinstall.js",
    "selfxyz-rn-mrz-scanner.podspec",
    "react-native.config.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "pnpm build",
    "test": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "types": "tsup"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "react-native": "0.83.9",
    "tsup": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.83.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
